# ==============================================================================
# 🌲 EcoGorniy Cabin Rental — Файл конфигурации переменных окружения (.env)
# ==============================================================================
# Скопируйте этот файл в .env перед запуском:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. ОБЩИЕ НАСТРОЙКИ СЕРВЕРА
# ------------------------------------------------------------------------------
# Режим работы: production (на сервере) или development (для локальной разработки)
NODE_ENV=production

# Порт, на котором будет работать Node.js сервер
PORT=3000

# Публичный базовый URL сайта (без завершающего слэша).
# Например: https://eco-gorniy.ru или https://mycabin.coolify.yourdomain.com
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ И ХРАНИЛИЩЕ ФАЙЛОВ (POCKETBASE)
# ------------------------------------------------------------------------------
# URL адрес запущенного сервера PocketBase.
# На одном сервере/в Docker сети: http://pocketbase:8090 или http://127.0.0.1:8090
# Если PocketBase вынесен на отдельный домен: https://pb.yourdomain.com
POCKETBASE_URL=http://127.0.0.1:8090

# Email учетной записи супер-администратора PocketBase (создается при первом входе в PB)
POCKETBASE_ADMIN_EMAIL=admin@example.com

# Пароль супер-администратора PocketBase (минимум 10 символов)
POCKETBASE_ADMIN_PASSWORD=your_pocketbase_strong_password_123

# ------------------------------------------------------------------------------
# 3. АВТОРИЗАЦИЯ В ПАНЕЛИ УПРАВЛЕНИЯ (ADMIN CMS)
# ------------------------------------------------------------------------------
# Логин администратора для входа в веб-панель (/admin/login)
ADMIN_USERNAME=admin

# Пароль администратора (задайте длинный надежный пароль)
ADMIN_PASSWORD=your_secret_admin_password_here

# Секретный ключ для подписи сессионных cookie (любая длинная случайная строка 32+ символов)
COOKIE_SECRET=change_me_to_a_random_32_chars_secret_string_xyz

# Время жизни сессии администратора в часах (по умолчанию 12 часов)
SESSION_TTL_HOURS=12

# ------------------------------------------------------------------------------
# 4. УВЕДОМЛЕНИЯ В TELEGRAM (ОПЦИОНАЛЬНО, НО РЕКОМЕНДУЕТСЯ)
# ------------------------------------------------------------------------------
# Токен бота от @BotFather (например: 1234567890:ABCdefGhIJKlmNoPQRstuvwxYZ)
TELEGRAM_BOT_TOKEN=

# Chat ID администратора или группы для получения заявок на бронь (от @userinfobot)
TELEGRAM_CHAT_ID=

# Секретный токен для вебхука (необязательно, детерминированно вычисляется)
TELEGRAM_WEBHOOK_SECRET=

# Для серверов с блокировками/нестабильным доступом к api.telegram.org:
# Адрес Cloudflare Worker Relay (см. папку cloudflare-worker/)
TELEGRAM_RELAY_URL=
# Секретный ключ ретранслятора (минимум 32 символа, должен совпадать с ключом в Cloudflare Worker)
TELEGRAM_RELAY_SECRET=

# ------------------------------------------------------------------------------
# 5. ИНТЕГРАЦИЯ С МАКС (MAX.RU BOT API) — ОПЦИОНАЛЬНО
# ------------------------------------------------------------------------------
MAX_BOT_TOKEN=
MAX_CHAT_ID=
MAX_WEBHOOK_SECRET=
MAX_API_URL=https://platform-api2.max.ru

# ------------------------------------------------------------------------------
# 6. ВНЕШНИЕ КАЛЕНДАРИ (СИНХРОНИЗАЦИЯ ICAL: АВИТО, СУТОЧНО, И Т.Д.)
# ------------------------------------------------------------------------------
# Интервал фоновой синхронизации внешних календарей в минутах (по умолчанию 30)
EXTERNAL_CALENDAR_SYNC_MINUTES=30

# Отключить фоновые задачи (iCal, Telegram polling) при локальных тестах: false или true
DISABLE_BACKGROUND_JOBS=false
